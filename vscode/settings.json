{
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[css]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "[html]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "C_Cpp.codeAnalysis.clangTidy.enabled": false,
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "/usr/include/**"
    ],
    "C_Cpp.doxygen.generatedStyle": "/**",
    "C_Cpp.intelliSenseEngine": "disabled",
    "chat.viewSessions.enabled": false,
    "clangd.path": "/usr/bin/clangd",
    "claudeCode.preferredLocation": "sidebar",
    "cmake.configureOnOpen": false,
    "cmake.showOptionsMovedNotification": false,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "dev.containers.defaultExtensions": [
        "anthropic.claude-code",
        "Gruntfuggly.todo-tree",
        "llvm-vs-code-extensions.vscode-clangd",
        "mhutchie.git-graph",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "oderwat.indent-rainbow"
    ],
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.detectIndentation": false,
    "editor.fontFamily": "'DroidSansM Nerd Font Mono', 'monospace', monospace",
    "editor.rulers": [
        80,
        120
    ],
    "explorer.confirmDelete": false,
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        ".bash_functions": "shellscript",
        ".clangd": "yaml"
    },
    "files.insertFinalNewline": true,
    "git.autorefresh": true,
    "git.blame.editorDecoration.enabled": true,
    "git.confirmSync": false,
    "github.copilot.enable": {
        "*": false
    },
    "indentRainbow.colors": [
        "rgba(255, 255, 64, 0.5)",
        "rgba(127, 255, 127, 0.5)",
        "rgba(255, 127, 255, 0.5)",
        "rgba(79, 236, 236, 0.5)"
    ],
    "indentRainbow.errorColor": "rgba(255,255,255,0.05)",
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 1,
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-c=%DIR%/",
        "-m",
        "-y=defaultIndent:'  ',modifyLineBreaks:textWrapOptions:columns:100",
        "%TMPFILE%"
    ],
    "peacock.favoriteColors": [
        {
            "name": "Red",
            "value": "#641414"
        },
        {
            "name": "Blue",
            "value": "#141464"
        },
        {
            "name": "Green",
            "value": "#146414"
        },
        {
            "name": "Purple",
            "value": "#3c1464"
        }
    ],
    "python.analysis.typeCheckingMode": "standard",
    "remote.SSH.defaultExtensions": [
        "Gruntfuggly.todo-tree",
        "mhutchie.git-graph",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "oderwat.indent-rainbow"
    ],
    "search.useGlobalIgnoreFiles": true,
    "telemetry.telemetryLevel": "off",
    "todo-tree.filtering.excludeGlobs": [
        "**/.git/COMMIT_EDITMSG"
    ],
    "todo-tree.general.showActivityBarBadge": true,
    "todo-tree.highlights.defaultHighlight": {
        "type": "text"
    },
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS):",
    "todo-tree.tree.expanded": true,
    "todo-tree.tree.flat": true,
    "vsicons.dontShowNewVersionMessage": true,
    "window.autoDetectColorScheme": true,
    "workbench.iconTheme": "vscode-icons",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none"
}
